#  1. INTEGER n
#  2. 2D_INTEGER_ARRAY queries
#

def dynamicArray(n, queries):
    # Initialize n empty sequences
    arr = [[] for _ in range(n)]
    lastAnswer = 0
    answers = []
    
    for query in queries:
        q_type = query[0]
        x = query[1]
        y = query[2]
        
        # Calculate the sequence index using bitwise XOR (^)
        idx = (x ^ lastAnswer) % n
        
        if q_type == 1:
            # Query type 1: Append y to the sequence at arr[idx]
            arr[idx].append(y)
        elif q_type == 2:
            # Query type 2: Find element, update lastAnswer, and store it
            element_idx = y % len(arr[idx])
            lastAnswer = arr[idx][element_idx]
            answers.append(lastAnswer)
            
    return answers

