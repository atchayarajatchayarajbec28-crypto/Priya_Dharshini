#include <stdio.h>

int removeDuplicates(int* nums, int numsSize) {
    // An empty array or an array with 1 element has no duplicates to remove
    if (numsSize == 0) {
        return 0;
    }

    int k = 1; // Tracks the position for the next unique element

    for (int i = 1; i < numsSize; i++) {
        // If the current element is different from the last unique element found
        if (nums[i] != nums[k - 1]) {
            nums[k] = nums[i]; // Move the unique element to the front
            k++;               // Advance the unique element pointer
        }
    }

    return k; // k represents the total number of unique elements
}
