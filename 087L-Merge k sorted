#include <stdio.h>
#include <stdlib.h>

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     struct ListNode *next;
 * };
 */

// Helper function to merge two sorted lists (from LeetCode 21)
struct ListNode* mergeTwoLists(struct ListNode* list1, struct ListNode* list2) {
    struct ListNode dummy;
    dummy.val = 0;
    dummy.next = NULL;
    struct ListNode* tail = &dummy;

    while (list1 != NULL && list2 != NULL) {
        if (list1->val <= list2->val) {
            tail->next = list1;
            list1 = list1->next;
        } else {
            tail->next = list2;
            list2 = list2->next;
        }
        tail = tail->next;
    }

    tail->next = (list1 != NULL) ? list1 : list2;
    return dummy.next;
}

struct ListNode* mergeKLists(struct ListNode** lists, int listsSize) {
    if (listsSize == 0) return NULL;
    
    // Divide and Conquer pair-merging
    while (listsSize > 1) {
        int newSize = 0;
        for (int i = 0; i < listsSize; i += 2) {
            // If there's a pair, merge them; otherwise keep the standalone list
            if (i + 1 < listsSize) {
                lists[newSize] = mergeTwoLists(lists[i], lists[i + 1]);
            } else {
                lists[newSize] = lists[i];
            }
            newSize++;
        }
        listsSize = newSize;
    }
    
    return lists[0];
}
